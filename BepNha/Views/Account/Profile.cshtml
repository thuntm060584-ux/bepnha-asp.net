@model ProfileForm
@{ ViewData["Title"] = "Hồ sơ cá nhân"; }
<section class="auth-section"><div class="auth-card"><span class="eyebrow">GÓC NHỎ CỦA BẠN</span><h1>Hồ sơ cá nhân</h1><form method="post" action="/account/profile">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="FullName">Họ tên</label><input asp-for="FullName" class="form-control" required maxlength="100" /><span asp-validation-for="FullName" class="text-danger"></span><label asp-for="Bio">Giới thiệu bản thân</label><textarea asp-for="Bio" class="form-control" rows="5" maxlength="1000"></textarea><span asp-validation-for="Bio" class="text-danger"></span><button class="theme-btn w-100 mt-4">Lưu hồ sơ</button></form><p class="mt-4"><a href="/account/password">Đổi mật khẩu</a> · <a href="/authors/@SessionService.UserId(User)">Xem trang tác giả của tôi</a></p></div></section>
