@model ChangePasswordForm
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<section class="auth-section"><div class="auth-card"><span class="eyebrow">BẢO VỆ TÀI KHOẢN</span><h1>Đổi mật khẩu</h1><form method="post" action="/account/password">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="OldPassword">Mật khẩu cũ</label><input asp-for="OldPassword" type="password" class="form-control" required autocomplete="current-password" /><span asp-validation-for="OldPassword" class="text-danger"></span><label asp-for="Password">Mật khẩu mới</label><input asp-for="Password" type="password" class="form-control" required minlength="8" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span><small>Ít nhất 8 ký tự, có chữ và số.</small><label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label><input asp-for="ConfirmPassword" type="password" class="form-control" required autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span><button class="theme-btn w-100 mt-4">Đổi mật khẩu</button></form><p class="mt-4"><a href="/account/profile">Về hồ sơ cá nhân</a></p></div></section>
