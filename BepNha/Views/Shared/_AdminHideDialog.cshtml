<div class="modal fade" id="hide-recipe" tabindex="-1" aria-labelledby="hide-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form method="post" id="hide-recipe-form">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="modal-title fs-5" id="hide-title">Ẩn công thức</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body"><p id="hide-recipe-name"></p><label for="hidden-reason" class="form-label">Lý do ẩn <span class="text-danger">*</span></label><textarea id="hidden-reason" name="reason" class="form-control" rows="4" data-val="true" data-val-required="Vui lòng nhập trường này." data-val-minlength="Lý do ẩn phải có ít nhất 5 ký tự." data-val-minlength-min="5" required minlength="5" maxlength="300"></textarea><span class="text-danger" data-valmsg-for="reason" data-valmsg-replace="true"></span><div class="form-text">Từ 5 đến 300 ký tự. Tác giả sẽ nhìn thấy lý do này.</div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button><button type="submit" class="btn btn-warning">Xác nhận ẩn</button></div></form></div></div></div>
<script>document.getElementById('hide-recipe').addEventListener('show.bs.modal',function(event){const trigger=event.relatedTarget;document.getElementById('hide-recipe-form').action='/admin/recipes/'+trigger.dataset.recipeId+'/hide';document.getElementById('hide-recipe-name').textContent=trigger.dataset.recipeTitle;document.getElementById('hidden-reason').value='';});</script>
