@model RecipeForm
@{ ViewData["Title"] = Model.Id.HasValue ? "Sửa công thức" : "Chia sẻ công thức"; }
<section class="page-banner"><div class="container"><span class="eyebrow">MANG MÓN NGON ĐẾN MỌI NGƯỜI</span><h1>@ViewData["Title"]</h1></div></section>
<section class="container page-section"><form method="post" action="@(Model.Id.HasValue ? $"/recipes/{Model.Id}/edit" : "/recipes/new")" enctype="multipart/form-data" class="editor-card" id="recipe-editor">@Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert validation-summary"></div>
    <h2>01. Câu chuyện món ăn</h2>
    <div class="row g-4">
        <div class="col-md-8"><label asp-for="Title">Tên công thức *</label><input asp-for="Title" class="form-control" required maxlength="200" /><span asp-validation-for="Title" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="CategoryId">Danh mục *</label><select asp-for="CategoryId" class="form-select" required><option value="">Chọn danh mục</option>@foreach (var c in Model.Categories) { <option value="@c.CategoryId">@c.CategoryName</option> }</select><span asp-validation-for="CategoryId" class="text-danger"></span></div>
        <div class="col-12"><label asp-for="Summary">Giới thiệu món ăn *</label><textarea asp-for="Summary" class="form-control" rows="3" required maxlength="2000"></textarea><span asp-validation-for="Summary" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="Difficulty">Độ khó</label><select asp-for="Difficulty" class="form-select"><option value="1">Dễ</option><option value="2">Trung bình</option><option value="3">Khó</option></select><span asp-validation-for="Difficulty" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="CookMinutes">Thời gian nấu (phút) *</label><input asp-for="CookMinutes" type="number" min="1" max="10080" class="form-control" required /><span asp-validation-for="CookMinutes" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="Servings">Khẩu phần (người) *</label><input asp-for="Servings" type="number" min="1" max="1000" class="form-control" required /><span asp-validation-for="Servings" class="text-danger"></span></div>
        <div class="col-12"><label asp-for="Cover">Ảnh đại diện @(Model.Id.HasValue ? "(bỏ trống để giữ ảnh cũ)" : "*")</label><div class="upload-field"><i class="fas fa-cloud-upload-alt" aria-hidden="true"></i><div><strong data-upload-title>Chọn ảnh món ăn của bạn</strong><span>Nhấn để chọn ảnh từ thiết bị</span></div><input asp-for="Cover" type="file" accept=".jpg,.png" data-val="@(!Model.Id.HasValue ? "true" : null)" data-val-required="Vui lòng chọn ảnh đại diện." data-msg-required="Vui lòng chọn ảnh đại diện." required="@(!Model.Id.HasValue)" aria-label="Chọn ảnh đại diện món ăn" /></div><span asp-validation-for="Cover" class="text-danger"></span><small>Chỉ nhận ảnh .JPG hoặc .PNG. Tối đa 5 MB.</small>@if (!string.IsNullOrWhiteSpace(Model.ExistingCover)) { <img class="cover-preview" src="@Model.ExistingCover" alt="Ảnh hiện tại" /> }</div>
    </div>
    <h2 class="mt-5">02. Nguyên liệu</h2><p>Nhập tên riêng từng nguyên liệu; định lượng gồm số lượng và đơn vị.</p>
    <div id="ingredient-lines">@for (int i = 0; i < Model.Ingredients.Count; i++) { <div class="ingredient-line dynamic-line"><div class="ingredient-field"><input asp-for="Ingredients[i].Name" class="form-control" placeholder="Tên nguyên liệu" aria-label="Tên nguyên liệu" data-msg-required="Vui lòng nhập trường này." required maxlength="100" /><span asp-validation-for="Ingredients[i].Name" class="text-danger"></span></div><div class="ingredient-field"><input asp-for="Ingredients[i].Quantity" class="form-control" placeholder="Ví dụ: 200 g" aria-label="Định lượng" data-msg-required="Vui lòng nhập trường này." required maxlength="100" /><span asp-validation-for="Ingredients[i].Quantity" class="text-danger"></span></div><button type="button" class="btn btn-outline-danger remove-line" aria-label="Xóa nguyên liệu">×</button></div> }</div><span asp-validation-for="Ingredients" class="text-danger"></span>
    <button type="button" class="btn btn-outline-success mt-2" id="add-ingredient">+ Thêm nguyên liệu</button>
    <h2 class="mt-5">03. Các bước thực hiện</h2><p>Mỗi ô là một bước, trình bày theo thứ tự nấu.</p>
    <div id="step-lines">@for (int i = 0; i < Model.Steps.Count; i++) { <div class="step-line dynamic-line"><span class="step-number">@(i + 1)</span><div class="step-field"><textarea asp-for="Steps[i]" class="form-control" rows="3" maxlength="4000" data-msg-required="Vui lòng nhập trường này." required aria-label="Bước thực hiện"></textarea><span asp-validation-for="Steps[i]" class="text-danger"></span></div><button type="button" class="btn btn-outline-danger remove-line" aria-label="Xóa bước">×</button></div> }</div><span asp-validation-for="Steps" class="text-danger"></span>
    <button type="button" class="btn btn-outline-success mt-2" id="add-step">+ Thêm bước</button><hr class="my-5" /><p>Công thức mới sẽ hiển thị ngay. Nếu đang bị ẩn, việc sửa không tự bật lại công thức.</p><button class="theme-btn" type="submit">@(Model.Id.HasValue ? "Lưu thay đổi" : "Đăng công thức") <i class="fas fa-arrow-right"></i></button><a class="btn ms-3" href="/recipes/mine">Quay lại</a>
</form></section>
