@model RecipeDetailsModel
@{ var r = Model.Recipe; var myId = SessionService.UserId(User); ViewData["Title"] = r.Title; }
<section class="page-banner"><div class="container"><span class="eyebrow">@r.Category.CategoryName</span><h1>@r.Title</h1><p><a href="/">Trang chủ</a> / <a href="/recipes">Công thức</a> / @r.DifficultyText</p></div></section>
<section class="container page-section">
    @if (!r.IsPublished) { <div class="alert alert-warning"><strong>Công thức đang bị ẩn:</strong> @r.HiddenReason</div> }
    <div class="row g-5"><div class="col-lg-8"><div class="detail-cover"><img src="@r.CoverImage" alt="@r.Title" /></div><div class="detail-meta my-4"><span>★ <b id="average-rating">@r.AverageRating.ToString("0.0")</b> / 5 · <span id="review-count">@r.Reviews.Count</span> đánh giá</span><span><i class="far fa-clock"></i> @r.CookMinutes phút</span><span>@r.Servings người</span><span>@r.DifficultyText</span></div><p class="lead">@r.Summary</p><h2 class="mt-5 mb-4">Cùng vào bếp</h2><ol class="instructions">@foreach (var step in r.Instructions.Split('\n', StringSplitOptions.RemoveEmptyEntries)) { <li>@step</li> }</ol><p class="small text-muted mt-4">Chia sẻ ngày @r.CreatedAt.ToString("dd/MM/yyyy") @if (r.UpdatedAt.HasValue) { <span> · Cập nhật @r.UpdatedAt.Value.ToString("dd/MM/yyyy")</span> }</p>
    @if (r.AuthorId == myId && User.IsInRole("member")) { <a class="btn btn-outline-success" href="/recipes/@r.RecipeId/edit">Sửa công thức của tôi</a> }
    </div><aside class="col-lg-4"><div class="side-card"><span class="eyebrow">CHUẨN BỊ THẬT ĐỦ</span><h2>Nguyên liệu</h2><ul class="ingredient-list">@foreach (var i in r.RecipeIngredients) { <li><span>@i.Ingredient.IngredientName</span><b>@i.Quantity</b></li> }</ul></div><div class="side-card mt-4"><span class="eyebrow">NGƯỜI GIỮ LỬA</span><h3><a href="/authors/@r.AuthorId">@r.Author.FullName</a></h3><p>@r.Author.Bio</p><p><b data-follower-count>@Model.Followers</b> người theo dõi</p>
    @if (User.IsInRole("member") && myId != r.AuthorId && r.Author.IsActive) { <form method="post" action="/follows/toggle" data-follow>@Html.AntiForgeryToken()<input type="hidden" name="followingId" value="@r.AuthorId" /><button class="theme-btn compact w-100" data-follow-button>@(Model.IsFollowing ? "Đang theo dõi · Bỏ theo dõi" : "Theo dõi tác giả")</button></form> } else if (User.Identity?.IsAuthenticated != true) { <a class="btn btn-outline-success" href="/auth/login?returnUrl=/recipes/@r.RecipeId">Đăng nhập để theo dõi</a> }
    </div></aside></div>
    <section class="reviews-section mt-5 pt-5 border-top" id="reviews"><span class="eyebrow">HƯƠNG VỊ TỪ CỘNG ĐỒNG</span><h2 class="mb-4">Đánh giá & nhận xét</h2>
    @if (User.IsInRole("member") && myId != r.AuthorId && r.IsPublished)
    {
        <form method="post" action="/reviews" class="review-form side-card mb-4" data-review>@Html.AntiForgeryToken()<input type="hidden" name="recipeId" value="@r.RecipeId" /><h3>@(Model.MyReview is null ? "Món này với bạn thế nào?" : "Cập nhật đánh giá của bạn")</h3><label for="rating">Số sao</label><select id="rating" name="rating" class="form-select rating-select" required>@for (int star = 5; star >= 1; star--) { <option value="@star" selected="@(Model.MyReview?.Rating == star)">@star sao</option> }</select><label for="comment">Nhận xét (không bắt buộc)</label><textarea id="comment" name="comment" maxlength="1000" rows="3" class="form-control">@Model.MyReview?.Comment</textarea><button class="theme-btn compact mt-3">@(Model.MyReview is null ? "Gửi đánh giá" : "Lưu đánh giá")</button><div class="ajax-message mt-2" role="status"></div></form>
    }
    else if (User.Identity?.IsAuthenticated != true) { <p class="side-card mb-4"><a href="/auth/login?returnUrl=/recipes/@r.RecipeId">Đăng nhập</a> để đánh giá và chia sẻ trải nghiệm nấu món này.</p> }
    else if (myId == r.AuthorId) { <p>Bạn không thể tự đánh giá công thức của mình.</p> }
    <div id="review-list">@if (r.Reviews.Count == 0) { <p>Chưa có đánh giá. Hãy là người đầu tiên thử món này!</p> }@foreach (var review in r.Reviews.OrderByDescending(x => x.CreatedAt)) { <article class="review-item"><div class="d-flex justify-content-between"><h4><a href="/authors/@review.ReviewerId">@review.Reviewer.FullName</a></h4><span class="rating">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</span></div><time class="small text-muted">@review.CreatedAt.ToString("dd/MM/yyyy")</time><p class="mt-2 review-comment">@review.Comment</p>@if (review.ReviewerId == myId && User.IsInRole("member")) { <form action="/reviews/@review.ReviewId/delete" method="post" data-review data-confirm="Xóa đánh giá của bạn?">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Xóa đánh giá của tôi</button></form> }@if (User.IsInRole("admin")) { <form action="/admin/reviews/@review.ReviewId/delete" method="post" data-confirm="Xóa đánh giá vi phạm?">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Xóa đánh giá vi phạm</button></form> }</article> }</div>
    </section>
</section>
