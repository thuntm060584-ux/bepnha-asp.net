@model List<Category>
@{ ViewData["Title"] = "Quản lý danh mục"; ViewData["Description"] = "Tổ chức danh mục để thành viên phân loại và tìm kiếm công thức."; string status = ViewBag.Status ?? "active"; }
<div class="category-create management-panel"><div><h2>Thêm danh mục</h2><p>Đặt tên ngắn gọn, dễ tìm kiếm.</p></div><form method="post" action="/admin/categories/save">@Html.AntiForgeryToken()<label for="new-category" class="visually-hidden">Tên danh mục mới</label><div class="category-field"><input class="form-control" id="new-category" name="name" data-val="true" data-val-required="Vui lòng nhập trường này." required maxlength="100" placeholder="Tên danh mục mới..." /><span class="text-danger" data-valmsg-for="name" data-valmsg-replace="true"></span></div><button class="btn btn-success text-nowrap"><i class="fas fa-plus"></i> Thêm mới</button></form></div>
<div class="management-panel"><form method="get" class="management-filter"><div class="filter-search"><label for="q">Tên danh mục</label><input id="q" name="q" value="@ViewBag.Q" class="form-control" placeholder="Tìm danh mục..." /></div><div><label for="status">Trạng thái</label><select id="status" name="status" class="form-select"><option value="active" selected="@(status == "active")">Đang sử dụng</option><option value="deleted" selected="@(status == "deleted")">Đã xóa</option><option value="all" selected="@(status == "all")">Tất cả dữ liệu</option></select></div><button class="btn btn-success">Lọc dữ liệu</button></form>
<div class="panel-caption"><h2>Danh sách danh mục <span>@Model.Count</span></h2><a href="/admin/categories?status=deleted">Đã xóa</a></div>
<div class="table-responsive"><table class="table management-table align-middle"><thead><tr><th scope="col">Tên danh mục</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead><tbody>@foreach (var c in Model) { <tr><td>@if (!c.IsDeleted) { <form id="category-@c.CategoryId" method="post" action="/admin/categories/save" class="category-edit">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.CategoryId" /><div class="category-field"><input name="name" value="@c.CategoryName" class="form-control" aria-label="Tên danh mục" data-val="true" data-val-required="Vui lòng nhập trường này." required maxlength="100" /><span class="text-danger" data-valmsg-for="name" data-valmsg-replace="true"></span></div><button class="btn btn-sm btn-outline-success">Lưu</button></form> } else { <b>@c.CategoryName</b> }</td><td><span class="status-pill @(c.IsDeleted ? "deleted" : "published")">@(c.IsDeleted ? "Đã xóa" : "Đang sử dụng")</span>@if(c.IsDeleted) { <small class="table-subtext">@c.DeletedAt?.ToString("dd/MM/yyyy HH:mm")</small> }</td><td>@if(c.IsDeleted) { <form method="post" action="/admin/categories/@c.CategoryId/undelete">@Html.AntiForgeryToken()<button class="btn btn-sm btn-success"><i class="fas fa-undo"></i> Khôi phục</button></form> } else { <form method="post" action="/admin/categories/@c.CategoryId/delete" data-confirm="Xóa mềm danh mục này? Bạn có thể khôi phục ở mục Đã xóa.">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Xóa</button></form> }</td></tr> }@if(!Model.Any()) { <tr><td colspan="3" class="table-empty"><strong>Không có danh mục phù hợp</strong></td></tr> }</tbody></table></div></div>
<p class="management-note"><i class="fas fa-info-circle"></i> Danh mục đã có công thức tham chiếu không thể xóa, kể cả công thức đã xóa mềm. Tên danh mục đã xóa được giữ lại để khôi phục.</p>
