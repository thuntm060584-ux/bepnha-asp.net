@model List<User>
@{ ViewData["Title"] = "Quản lý người dùng"; ViewData["Description"] = "Tra cứu tài khoản, kiểm tra vai trò và khóa hoặc mở khóa quyền truy cập."; string status = ViewBag.Status ?? "all"; }
<div class="management-panel"><form method="get" class="management-filter"><div class="filter-search"><label for="q">Họ tên hoặc email</label><input id="q" name="q" value="@ViewBag.Q" class="form-control" placeholder="Tìm người dùng..." /></div><div><label for="status">Trạng thái tài khoản</label><select class="form-select" id="status" name="status"><option value="all" selected="@(status == "all")">Tất cả tài khoản</option><option value="active" selected="@(status == "active")">Đang hoạt động</option><option value="locked" selected="@(status == "locked")">Đã khóa</option></select></div><button class="btn btn-success">Lọc dữ liệu</button></form>
<div class="panel-caption"><h2>Danh sách người dùng <span>@Model.Count</span></h2></div>
<div class="table-responsive"><table class="table management-table align-middle"><thead><tr><th scope="col">Người dùng</th><th scope="col">Email</th><th scope="col">Vai trò</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead><tbody>@foreach(var u in Model) { <tr><td><div class="user-cell"><span class="user-initial">@u.FullName[..1]</span><span><b>@u.FullName</b><small>Tham gia @u.CreatedAt.ToString("dd/MM/yyyy")</small></span></div></td><td>@u.Email</td><td><span class="role-label">@(u.Role == "admin" ? "Quản trị viên" : "Thành viên")</span></td><td><span class="status-pill @(u.IsActive ? "published" : "deleted")">@(u.IsActive ? "Hoạt động" : "Đã khóa")</span></td><td>@if(u.UserId != SessionService.UserId(User)) { <form method="post" action="/admin/users/@u.UserId/toggle" data-confirm="@(u.IsActive ? "Khóa quyền truy cập của tài khoản này?" : "Mở khóa tài khoản này?")">@Html.AntiForgeryToken()<button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")"><i class="fas @(u.IsActive ? "fa-lock" : "fa-unlock")"></i> @(u.IsActive ? "Khóa tài khoản" : "Mở khóa")</button></form> } else { <span class="table-subtext">Tài khoản của bạn</span> }</td></tr> }@if(!Model.Any()) { <tr><td colspan="5" class="table-empty"><strong>Không tìm thấy người dùng</strong></td></tr> }</tbody></table></div></div>
