@model AdminReviewsModel
@{ ViewData["Title"] = "Quản lý đánh giá"; ViewData["Description"] = "Kiểm tra nhận xét của cộng đồng, xóa mềm nội dung vi phạm và khôi phục khi cần."; }
<div class="management-panel"><form method="get" class="management-filter"><div class="filter-search"><label for="q">Công thức, người đánh giá hoặc nhận xét</label><input class="form-control" id="q" name="q" value="@Model.Q" placeholder="Tìm đánh giá..." /></div><div><label for="status">Trạng thái</label><select name="status" id="status" class="form-select"><option value="active" selected="@(Model.Status == "active")">Đang sử dụng</option><option value="deleted" selected="@(Model.Status == "deleted")">Đã xóa</option><option value="all" selected="@(Model.Status == "all")">Tất cả dữ liệu</option></select></div><button class="btn btn-success">Lọc dữ liệu</button></form>
<div class="panel-caption"><h2>Danh sách đánh giá <span>@Model.Total</span></h2><a href="/admin/reviews?status=deleted">Đã xóa</a></div>
<div class="table-responsive"><table class="table management-table align-middle"><thead><tr><th scope="col">Công thức / Người đánh giá</th><th scope="col">Số sao</th><th scope="col">Nhận xét</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead><tbody>@foreach(var r in Model.Reviews) { <tr><td><a class="table-title" href="/admin/recipes/@r.RecipeId">@r.Recipe.Title</a><small class="table-subtext">@r.Reviewer.FullName · @r.CreatedAt.ToString("dd/MM/yyyy")</small></td><td><span class="rating-text">★ @r.Rating / 5</span></td><td class="review-content">@(string.IsNullOrWhiteSpace(r.Comment) ? "Không có nhận xét" : r.Comment)</td><td><span class="status-pill @(r.IsDeleted ? "deleted" : r.Recipe.IsDeleted ? "hidden" : "published")">@(r.IsDeleted ? "Đã xóa" : r.Recipe.IsDeleted ? "Công thức đã xóa" : "Đang sử dụng")</span></td><td>@if(r.IsDeleted) { @if(!r.Recipe.IsDeleted) { <form method="post" action="/admin/reviews/@r.ReviewId/undelete">@Html.AntiForgeryToken()<button class="btn btn-sm btn-success">Khôi phục</button></form> } else { <span class="table-subtext">Khôi phục công thức trước</span> } } else { <form method="post" action="/admin/reviews/@r.ReviewId/delete" data-confirm="Xóa mềm đánh giá này?">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Xóa đánh giá</button></form> }</td></tr> }@if(!Model.Reviews.Any()) { <tr><td colspan="5" class="table-empty"><strong>Không có đánh giá phù hợp</strong></td></tr> }</tbody></table></div>
<div class="panel-pagination"><span>Trang @Model.Page / @Model.Pages · @Model.Total kết quả</span><nav aria-label="Phân trang đánh giá"><ul class="pagination mb-0">@for(int p=Math.Max(1,Model.Page-2);p<=Math.Min(Model.Pages,Model.Page+2);p++){<li class="page-item @(p==Model.Page?"active":"")"><a class="page-link" href="?q=@Uri.EscapeDataString(Model.Q??"")&status=@Model.Status&page=@p">@p</a></li>}</ul></nav></div></div>
