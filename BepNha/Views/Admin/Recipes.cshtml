@model AdminRecipesModel
@{ ViewData["Title"] = "Quản lý công thức"; ViewData["Description"] = "Tra cứu, hậu kiểm và quản lý trạng thái công thức của cộng đồng."; }
<div class="management-panel">
<form method="get" class="management-filter"><div class="filter-search"><label for="q">Tìm công thức hoặc tác giả</label><input class="form-control" id="q" name="q" value="@Model.Q" placeholder="Nhập tên công thức hoặc tác giả..." /></div><div><label for="status">Trạng thái</label><select class="form-select" id="status" name="status"><option value="active" selected="@(Model.Status == "active")">Tất cả chưa xóa</option><option value="published" selected="@(Model.Status == "published")">Đang hiển thị</option><option value="hidden" selected="@(Model.Status == "hidden")">Đang ẩn</option><option value="deleted" selected="@(Model.Status == "deleted")">Đã xóa</option><option value="all" selected="@(Model.Status == "all")">Tất cả dữ liệu</option></select></div><button class="btn btn-success" type="submit"><i class="fas fa-search"></i> Lọc dữ liệu</button></form>
<div class="panel-caption"><h2>Danh sách công thức <span>@Model.Total</span></h2><a href="/admin/recipes?status=deleted"><i class="far fa-trash-alt"></i> Đã xóa</a></div>
<div class="table-responsive"><table class="table management-table align-middle"><thead><tr><th scope="col">Công thức</th><th scope="col">Tác giả / Danh mục</th><th scope="col">Đánh giá</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead><tbody>
@foreach (var r in Model.Recipes) { <tr><td><a class="recipe-cell" href="/admin/recipes/@r.RecipeId"><img src="@r.CoverImage" alt="" /><span><b>@r.Title</b><small>@r.CreatedAt.ToString("dd/MM/yyyy")</small></span></a></td><td><span>@r.Author.FullName</span><small class="table-subtext">@r.Category.CategoryName</small></td><td><span class="rating-text">★ @r.AverageRating.ToString("0.0")</span><small class="table-subtext">@r.Reviews.Count đánh giá</small></td><td>@if (r.IsDeleted) { <span class="status-pill deleted">Đã xóa</span><small class="table-subtext">@r.DeletedAt?.ToString("dd/MM/yyyy HH:mm")</small> } else if (r.IsPublished) { <span class="status-pill published">Đang hiển thị</span> } else { <span class="status-pill hidden">Đang ẩn</span><small class="table-subtext hidden-reason" title="@r.HiddenReason">@r.HiddenReason</small> }</td><td><a class="detail-link" href="/admin/recipes/@r.RecipeId">Chi tiết <i class="fas fa-arrow-right"></i></a><partial name="_AdminRecipeActions" model="r" /></td></tr> }
@if (!Model.Recipes.Any()) { <tr><td colspan="5" class="table-empty"><i class="far fa-folder-open"></i><strong>Không có công thức phù hợp</strong><span>Thử từ khóa hoặc trạng thái khác.</span></td></tr> }
</tbody></table></div>
<div class="panel-pagination"><span>Trang @Model.Page / @Model.Pages · @Model.Total kết quả</span><nav aria-label="Phân trang công thức"><ul class="pagination mb-0">@for(int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.Pages, Model.Page + 2); p++) { <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="?q=@Uri.EscapeDataString(Model.Q ?? "")&status=@Model.Status&page=@p">@p</a></li> }</ul></nav></div>
</div>
<p class="management-note"><i class="fas fa-info-circle"></i> Xóa mềm giữ lại công thức, ảnh, nguyên liệu và đánh giá. Chọn trạng thái “Đã xóa” để khôi phục.</p>
<partial name="_AdminHideDialog" />
