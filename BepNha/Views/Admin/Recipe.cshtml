@model Recipe
@{ ViewData["Title"] = "Chi tiết công thức"; ViewData["Description"] = "Xem thông tin và xử lý nội dung trong khu vực quản trị."; }
<div class="management-toolbar"><a class="btn btn-light" href="/admin/recipes"><i class="fas fa-arrow-left"></i> Danh sách công thức</a><partial name="_AdminRecipeActions" model="Model" /></div>
@if(Model.IsDeleted) { <div class="alert alert-secondary">Công thức đã xóa mềm ngày @Model.DeletedAt?.ToString("dd/MM/yyyy HH:mm"). Nội dung chỉ hiển thị trong khu vực quản trị.</div> }
@if(!Model.IsPublished) { <div class="alert alert-warning"><strong>Lý do ẩn:</strong> @Model.HiddenReason</div> }
<div class="management-panel admin-recipe-detail"><div class="detail-summary"><img src="@Model.CoverImage" alt="@Model.Title" /><div><span class="admin-eyebrow">CHI TIẾT CÔNG THỨC</span><h2>@Model.Title</h2><dl><dt>Tác giả</dt><dd>@Model.Author.FullName</dd><dt>Danh mục</dt><dd>@Model.Category.CategoryName</dd><dt>Thời gian / Khẩu phần</dt><dd>@Model.CookMinutes phút / @Model.Servings người</dd><dt>Độ khó</dt><dd>@Model.DifficultyText</dd><dt>Ngày đăng</dt><dd>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd></dl></div></div><p class="detail-description">@Model.Summary</p>
<div class="detail-columns"><section><h3>Nguyên liệu</h3><table class="table table-sm"><tbody>@foreach(var i in Model.RecipeIngredients){<tr><td>@i.Ingredient.IngredientName</td><td>@i.Quantity</td></tr>}</tbody></table></section><section><h3>Các bước thực hiện</h3><ol>@foreach(var step in Model.Instructions.Split('\n',StringSplitOptions.RemoveEmptyEntries)){<li>@step</li>}</ol></section></div></div>
<div class="management-panel mt-4"><div class="panel-caption"><h2>Đánh giá của công thức <span>@Model.Reviews.Count</span></h2><a href="/admin/reviews">Quản lý tất cả đánh giá</a></div><div class="table-responsive"><table class="table management-table"><thead><tr><th>Người đánh giá</th><th>Số sao</th><th>Nhận xét</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var r in Model.Reviews.OrderByDescending(x=>x.CreatedAt)){<tr><td>@r.Reviewer.FullName</td><td class="rating-text">★ @r.Rating</td><td class="review-content">@r.Comment</td><td><span class="status-pill @(r.IsDeleted?"deleted":"published")">@(r.IsDeleted?"Đã xóa":"Đang sử dụng")</span></td><td>@if(!r.IsDeleted){<form method="post" action="/admin/reviews/@r.ReviewId/delete" data-confirm="Xóa mềm đánh giá này?">@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="/admin/recipes/@Model.RecipeId" /><button class="btn btn-sm btn-outline-danger">Xóa đánh giá</button></form>}else if(!Model.IsDeleted){<form method="post" action="/admin/reviews/@r.ReviewId/undelete">@Html.AntiForgeryToken()<button class="btn btn-sm btn-success">Khôi phục</button></form>}</td></tr>}@if(!Model.Reviews.Any()){<tr><td colspan="5" class="table-empty">Chưa có đánh giá.</td></tr>}</tbody></table></div></div>
<partial name="_AdminHideDialog" />
