@model LoginForm
@{ ViewData["Title"] = "Đăng nhập"; }
<section class="auth-section auth-split"><partial name="_AuthIntro" /><div class="auth-card"><span class="eyebrow">CHÀO MỪNG BẠN TRỞ LẠI</span><h1>Đăng nhập</h1><p>Tiếp tục câu chuyện trong căn bếp của bạn.</p><form method="post" action="/auth/login">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="ReturnUrl" type="hidden" /><label asp-for="Email">Email</label><input asp-for="Email" type="email" class="form-control" autocomplete="email" required maxlength="254" /><span asp-validation-for="Email" class="text-danger"></span><label asp-for="Password">Mật khẩu</label><input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required /><span asp-validation-for="Password" class="text-danger"></span><button class="theme-btn w-100 mt-4">Đăng nhập</button></form><div class="d-flex justify-content-between mt-4"><a href="/auth/forgot-password">Quên mật khẩu?</a><a href="/auth/register">Tạo tài khoản</a></div></div></section>
