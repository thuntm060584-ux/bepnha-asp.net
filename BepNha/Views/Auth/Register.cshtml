@model RegisterForm
@{ ViewData["Title"] = "Đăng ký"; }
<section class="auth-section auth-split"><partial name="_AuthIntro" /><div class="auth-card"><span class="eyebrow">CĂN BẾP LUÔN CHÀO ĐÓN BẠN</span><h1>Tham gia cộng đồng</h1><p>Cùng chia sẻ món ngon và niềm vui vào bếp.</p><form method="post" action="/auth/register">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="FullName">Họ tên</label><input asp-for="FullName" class="form-control" autocomplete="name" required maxlength="100" /><span asp-validation-for="FullName" class="text-danger"></span><label asp-for="Email">Email</label><input asp-for="Email" type="email" class="form-control" autocomplete="email" required maxlength="254" /><span asp-validation-for="Email" class="text-danger"></span><label asp-for="Password">Mật khẩu</label><input asp-for="Password" type="password" class="form-control" autocomplete="new-password" required minlength="8" /><span asp-validation-for="Password" class="text-danger"></span><small>Ít nhất 8 ký tự, có chữ và số.</small><label asp-for="ConfirmPassword">Nhập lại mật khẩu</label><input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" required /><span asp-validation-for="ConfirmPassword" class="text-danger"></span><button class="theme-btn w-100 mt-4">Tạo tài khoản</button></form><p class="mt-4 mb-0">Đã có tài khoản? <a href="/auth/login">Đăng nhập</a></p></div></section>

