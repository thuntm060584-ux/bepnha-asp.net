@model ResetForm
@{ ViewData["Title"] = "Đặt lại mật khẩu"; }
<section class="auth-section auth-split"><partial name="_AuthIntro" /><div class="auth-card"><span class="eyebrow">BẮT ĐẦU LẠI THẬT DỄ DÀNG</span><h1>Mật khẩu mới</h1><p>Liên kết này chỉ dùng một lần. Sau khi lưu mật khẩu, bạn cần đăng nhập lại.</p><form method="post" action="/auth/reset-password">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="Token" type="hidden" /><label asp-for="Password">Mật khẩu mới</label><input asp-for="Password" type="password" class="form-control" required minlength="8" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span><small>Ít nhất 8 ký tự, có chữ và số.</small><label asp-for="ConfirmPassword">Nhập lại mật khẩu</label><input asp-for="ConfirmPassword" type="password" class="form-control" required autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span><button class="theme-btn w-100 mt-4">Lưu mật khẩu mới</button></form><p class="mt-4"><a href="/auth/forgot-password">Yêu cầu liên kết mới</a></p></div></section>

