@model ForgotForm
@{ ViewData["Title"] = "Quên mật khẩu"; }
<section class="auth-section auth-split"><partial name="_AuthIntro" /><div class="auth-card"><span class="eyebrow">LẤY LẠI QUYỀN TRUY CẬP</span><h1>Quên mật khẩu</h1><p>Nhập email đã đăng ký. Liên kết đặt lại sẽ hiển thị trên trang này và không bị giới hạn thời gian.</p><form method="post" action="/auth/forgot-password">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Email">Email tài khoản</label><input asp-for="Email" type="email" class="form-control" required /><span asp-validation-for="Email" class="text-danger"></span><button class="theme-btn w-100 mt-4">Tạo liên kết đặt lại</button></form>@if (Model.ResetLink is not null) { <div class="alert alert-success mt-4"><p>Liên kết chỉ dùng một lần. Tạo liên kết mới sẽ vô hiệu hóa liên kết cũ.</p><a class="text-break" id="reset-link" href="@Model.ResetLink">Đặt lại mật khẩu ngay</a></div> }<p class="mt-4"><a href="/auth/login">Về đăng nhập</a></p></div></section>

